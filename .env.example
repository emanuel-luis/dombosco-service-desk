# Copy to .env at the repo root: `make demo` does it for you and fills SECRET_KEY.
# docker compose reads that file; running the backend outside Docker reads backend/.env
# (or the environment). Never commit real values.
# Variable names are case-insensitive. Empty values count as unset.

# --- Required ---------------------------------------------------------------
# At least 32 characters (it also signs the JWTs).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- Core -------------------------------------------------------------------
# Never enable DEBUG in production.
DEBUG=false
# Comma-separated lists.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Any URL dj-database-url understands. Default: sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/dombosco

# --- Docker demo (compose.yaml) -----------------------------------------------
# Demo only: password of every @demo.example user created by `manage.py seed_demo`.
# Compose pins DATABASE_URL to its own throwaway Postgres and ignores the one below.
# Default when unset: demo-only-change-me
# DEMO_PASSWORD=demo-only-change-me

# --- Frontend ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Where allauth redirects after confirming an email address. Default: FRONTEND_URL + /login
# LOGIN_URL=http://localhost:3000/login

# --- Email ------------------------------------------------------------------
# Defaults to the console backend (messages are printed, not sent).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# "mandatory", "optional" or "none".
ACCOUNT_EMAIL_VERIFICATION=mandatory
# Users who confirm an email at this domain or one of its subdomains join the Colaborador group.
# Unset = nobody does.
# DOM_BOSCO_EMAIL_DOMAIN=@example.edu

# --- Google login (enabled only when GOOGLE_OAUTH_CLIENT_ID is set) --------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/login/google/callback
